        <servlet-name>SprintBacklogLinkServlet</servlet-name>
        <servlet-class>servlets.SprintBacklogLinkServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>TaskServlet</servlet-name>
        <servlet-class>servlets.TaskServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>TaskAssignmentServlet</servlet-name>
        <servlet-class>servlets.TaskAssignmentServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>ProjectDocumentServlet</servlet-name>
        <servlet-class>servlets.ProjectDocumentServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>BacklogDocumentServlet</servlet-name>
        <servlet-class>servlets.BacklogDocumentServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>login_signUpServlet</servlet-name>
        <url-pattern>/login_signUpServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>profileServlet</servlet-name>
        <url-pattern>/profileServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>dashboardServlet</servlet-name>
        <url-pattern>/dashboardServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ProjectPageServlet</servlet-name>
        <url-pattern>/ProjectPageServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>teamAssignmentServlet</servlet-name>
