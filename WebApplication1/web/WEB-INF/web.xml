<?xml version="1.0" encoding="UTF-8"?>
<web-app version="3.1" xmlns="http://xmlns.jcp.org/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd">
    <servlet>
        <servlet-name>login_signUpServlet</servlet-name>
        <servlet-class>servlets.login_signUpServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>profileServlet</servlet-name>
        <servlet-class>servlets.profileServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>dashboardServlet</servlet-name>
        <servlet-class>servlets.dashboardServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>projectPageServlet</servlet-name>
        <servlet-class>servlets.projectPageServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>teamAssignmentServlet</servlet-name>
        <servlet-class>servlets.teamAssignmentServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>login_signUpServlet</servlet-name>
        <url-pattern>/login_signUpServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>profileServlet</servlet-name>
        <url-pattern>/profileServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>dashboardServlet</servlet-name>
        <url-pattern>/dashboardServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>projectPageServlet</servlet-name>
        <url-pattern>/projectPageServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>teamAssignmentServlet</servlet-name>
        <url-pattern>/teamAssignmentServlet</url-pattern>
    </servlet-mapping>
    <session-config>
        <session-timeout>
            30
        </session-timeout>
    </session-config>
</web-app>
