        <servlet-name>BacklogServlet</servlet-name>
        <url-pattern>/BacklogServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>SprintServlet</servlet-name>
        <url-pattern>/SprintServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>SprintBacklogLinkServlet</servlet-name>
        <url-pattern>/SprintBacklogLinkServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>TaskServlet</servlet-name>
        <url-pattern>/TaskServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>TaskAssignmentServlet</servlet-name>
        <url-pattern>/TaskAssignmentServlet</url-pattern>
    </servlet-mapping>
